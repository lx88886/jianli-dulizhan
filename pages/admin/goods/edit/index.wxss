/* ============ 容器 ============ */
.edit-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* ============ 区块 ============ */
.section {
  background: #fff;
  margin-bottom: 20rpx;
}

.section-title {
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
}

/* ============ 表单项 ============ */
.form-item {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.form-label.required::before {
  content: '*';
  color: #E34D59;
  margin-right: 8rpx;
}

.upload-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.cell-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.cell-note {
  font-size: 28rpx;
  color: #999;
}

/* ============ 规格管理 ============ */
.spec-list {
  padding: 24rpx 32rpx;
}

.spec-item {
  background: #f9f9f9;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.spec-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.spec-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.spec-values {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.spec-value-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

/* ============ 添加规格面板 ============ */
.add-spec-panel {
  padding: 24rpx 32rpx;
  background: #f9f9f9;
  margin-top: 16rpx;
}

.spec-values-input {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.spec-values-input .spec-value-tag {
  padding: 12rpx 20rpx;
  background: #e7f0ff;
  color: #0052D9;
  gap: 8rpx;
}

.add-spec-value-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

/* ============ SKU列表 ============ */
.sku-section {
  padding: 24rpx 32rpx;
  margin-top: 16rpx;
}

.sku-list {
  margin-top: 16rpx;
}

.sku-item {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sku-specs {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.sku-spec-text {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: #fff;
  border-radius: 4rpx;
  font-size: 24rpx;
  color: #666;
}

.sku-stock {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sku-label {
  font-size: 26rpx;
  color: #666;
}

/* ============ 底部按钮 ============ */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}
